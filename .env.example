# Local deployment configuration.
# Copy to .env and fill in the LLM section before starting a review:
#   cp .env.example .env
# NOTE: .env must never be committed or baked into the image.

# ---------------------------------------------------------------------------
# REQUIRED: OpenAI-compatible LLM endpoint (the only external dependency).
# Leave empty to boot with degraded health; reviews will return an SSE error.
#
# Examples (vendor-neutral — any endpoint speaking the OpenAI protocol works):
#   OpenAI:        https://api.openai.com/v1          model: gpt-4o
#   DeepSeek:      https://api.deepseek.com/v1        model: deepseek-chat
#   Moonshot:      https://api.moonshot.cn/v1         model: moonshot-v1-128k
#   Qwen (dashscope compatible mode): https://dashscope.aliyuncs.com/compatible-mode/v1  model: qwen-max
#   Intranet vLLM: http://vllm.internal:8000/v1       model: <served-model-name>
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---------------------------------------------------------------------------
# Authentication (local accounts + JWT)
# CHANGE jwt_secret AND admin_password BEFORE EXPOSING THIS SERVICE.
# Set AUTH_DISABLED=true for a single-user, login-free deployment.
# ---------------------------------------------------------------------------
AUTH_DISABLED=false
JWT_SECRET=change-me-before-exposing-this-service
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------------------------------------------------------------------------
# Review pipeline tuning (optional)
# ---------------------------------------------------------------------------
LLM_STRICT_JSON=true      # json_schema structured output; auto-falls back to json_object
LLM_SHOTS=5               # concurrent detection shots per chunk
LLM_MAX_WORKERS=8         # global cap on concurrent LLM requests per review (mind rate limits)
CHUNK_MAX_WORKERS=2       # chunks kept in flight (bounded look-ahead, order preserved)
LLM_MAX_RETRIES=2         # JSON-validation retries
LLM_TRANSIENT_RETRIES=5   # 429/5xx/timeout retries (exponential backoff)
LLM_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=8192
CONSOLIDATOR_BATCH_SIZE=10  # issues per consolidator call (verdicts are verbose)
PARAGRAPHS_PER_CHUNK=16

# ---------------------------------------------------------------------------
# OCR for scanned PDFs (default off; needs the tesseract binary + language
# packs installed in the image/runtime — not enabled in the default image)
# ---------------------------------------------------------------------------
OCR_ENABLED=false
OCR_LANGUAGES=eng

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
DATA_DIR=data
DEBUG=false
LOG_LEVEL=INFO
MAX_UPLOAD_MB=50
SERVE_STATIC=true
# Comma-separated whitelist; the UI is served same-origin so this only
# matters for the vite dev server (http://localhost:5173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
